{
  "name": "roadgraph-router",
  "version": "0.2.0",
  "description": "Compile any OpenStreetMap PBF extract into compact, range-addressable routing bundles and route over them with A* in Node.js or the browser.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "scripts/roadgraph-compile.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "routing",
    "road-graph",
    "a-star",
    "openstreetmap",
    "osm",
    "pbf",
    "offline",
    "browser",
    "turn-restrictions",
    "geojson"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieljvsa/roadgraph-router.git"
  },
  "bugs": {
    "url": "https://github.com/danieljvsa/roadgraph-router/issues"
  },
  "homepage": "https://github.com/danieljvsa/roadgraph-router#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "bin": {
    "roadgraph-compile": "scripts/roadgraph-compile.mjs"
  },
  "scripts": {
    "build": "tsup src/index.ts src/worker.ts --format esm --dts --clean",
    "check": "tsc --noEmit",
    "test": "jest --runInBand",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "compile": "npm run build && node scripts/roadgraph-compile.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "osm-pbf-parser-node": "^1.1.4"
  },
  "overrides": {
    "argparse": "^2.0.1",
    "esbuild": "^0.28.1"
  },
  "sideEffects": false
}
